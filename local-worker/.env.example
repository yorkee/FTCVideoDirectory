# Supabase project URL (not the dashboard URL)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase service-role/secret key. Keep this file private and never commit it.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Poll immediately at startup, then every 3 hours.
POLL_INTERVAL_SECONDS=10800
